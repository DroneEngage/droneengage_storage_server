{
    // Server configuration
    "server_id"                     : "DE_StorageSrv",
    "server_ip"                     : "::",
    "public_host"                   : "127.0.0.1",
    "server_port"                   : 9000,
    "enable_SSL"                    : false,

    // S2S connection to AUTH server
    "s2s_ws_target_ip"              : "127.0.0.1",
    "s2s_ws_target_port"            : "19001",
    "ssl_key_file"                  : "./ssl_local/ssl_airgap/domain.key",
    "ssl_cert_file"                 : "./ssl_local/ssl_airgap/domain.crt",
    "allow_fake_SSL"                : true,
    "ca_cert_path"                  : "./ssl_local/ssl_airgap/root.crt",
    
    // Server-to-Server (S2S) authentication. Ed25519 key pair generated by gen_s2s_keys.js
    // Storage server CONNECTS to Auth (needs private key).
    "s2s_my_private_key"            : "./ssl_local/DE_StorageSrv_private.pem",
    
    // Trusted comm server public keys for S2S auth (when accepting connections)
    "s2s_trusted_server_keys"       : {
        "DE_CommSrv"                : "./ssl_local/DE_ServerComm_public.pem"
    },
    
    // Database configuration
    "database": {
        "path"                      : "./data/storage.db",
        "maxConnections"            : 10
    },
    
    // WebSocket configuration
    "websocket": {
        "pingInterval"              : 30000,
        "pingTimeout"               : 5000
    },
    
    // Logging configuration
    "ignoreLog"                     : false,
    "log_directory"                 : "./logs/",
    "log_timeZone"                  : "GMT",
    "log_detailed"                  : false,
    
    // Queue configuration
    "queue": {
        "maxQueueSize"              : 1000,
        "retryInterval"             : 5000
    }
}
