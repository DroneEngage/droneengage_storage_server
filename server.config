{
    // Server configuration
    "server_id"                     : "DE_StorageSrv",
    "server_ip"                     : "::",
    "public_host"                   : "127.0.0.1",
    "server_port"                   : 9000,
    "enable_SSL"                    : true,  // SSL independent of S2S cert.

    // SSL certificates for WebSocket server
    "ssl_key_file"                  : "./ssl_local/ssl_airgap/domain.key",
    "ssl_cert_file"                 : "./ssl_local/ssl_airgap/domain.crt",
    "allow_fake_SSL"                : true,
    "ca_cert_path"                  : "./ssl_local/ssl_airgap/root.crt",

    // Server-to-Server (S2S) certificate authentication for accepting comm server connections
    "s2s_cert_enabled"              : false,
    "s2s_trusted_server_keys"       : {
        "DE_CommSrv"                : "./ssl_local/DE_ServerComm_public.pem"
    },
    
    // Database configuration
    "database": {
        "path"                      : "./data/storage.db",
        "maxConnections"            : 10
    },
    
    // Logging configuration
    "ignoreLog"                     : false,
    "log_directory"                 : "./logs/",
    "log_timeZone"                  : "GMT",
    "log_detailed"                  : false,
    
    // Queue configuration
    "queue": {
        "maxQueueSize"              : 1000,
        "retryInterval"             : 5000
    },

    // Dashboard (admin web UI) configuration
    // A separate HTTPS server on its own port, mirroring the authenticator's
    // webadmin panel.  Read-only observation of stored tasks/missions/units/
    // access_log/offline_queue.  All write operations stay on the S2S WS path.
    "dashboard_enable"              : true,
    "dashboard_port"                : 9001,
    "dashboard_listening_ip"        : "127.0.0.1",   // bind localhost for safety; set to 0.0.0.0 to expose
    "dashboard_url_guid"            : "",            // optional secret URL prefix, e.g. "abc123def" → /admin/abc123def/...
    "admin_username"                : "admin",
    "admin_password"                : "CHANGE_ME",   // plaintext, or $$HASH$$('password') to auto-hash on first run
    "session_secret"                : "change-this-secret-in-production"
}
