<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/public/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #212529; color: #f8f9fa; }
        .navbar-custom { background: #343a40; }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link { color: #f8f9fa !important; }
        .card { background: #2c3034; border: 1px solid #495057; }
        .card-header { background: #2c3034; border-bottom: 1px solid #495057; color: #f8f9fa; }
        .text-muted { color: #adb5bd !important; }
        .btn-primary { background: #0d6efd; border: none; }
        .btn-primary:hover { background: #0b5ed7; }
        .btn-outline-light { border-color: #f8f9fa; color: #f8f9fa; }
        .btn-outline-light:hover { background: #f8f9fa; color: #212529; }
        .table { color: #f8f9fa; border-color: #495057; }
        .table > :not(caption) > * > * {
            background-color: transparent; color: #f8f9fa; border-color: #495057;
        }
        .table-light { background: #2c3034; color: #f8f9fa; }
        .form-control, .form-select {
            background: #2c3034; border: 1px solid #495057; color: #f8f9fa;
        }
        .form-control:focus, .form-select:focus {
            background: #2c3034; border-color: #86b7fe; color: #f8f9fa;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .json-pre {
            background: #1a1d20; color: #d1d5db; padding: 0.75rem;
            border-radius: 4px; font-size: 0.8rem; max-height: 300px;
            overflow: auto; white-space: pre-wrap; word-break: break-all;
        }
    </style>
</head>
<body>
    <%- include('../common/navbar', { activePage: 'queue', navbarFixed: false, dashboardGuid: dashboardGuid, adminUsername: adminUsername }) %>

    <div class="container-fluid mt-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Offline Queue</h5>
                <button class="btn btn-primary btn-sm" onclick="loadQueue()">Refresh</button>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Per-unit message buffer for units that are offline. Messages are delivered when a unit comes online (UnitOnline 9009).</p>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Unit ID</label>
                        <select class="form-select form-select-sm" id="filterUnit">
                            <option value="">All units</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Status</label>
                        <select class="form-select form-select-sm" id="filterStatus">
                            <option value="">All</option>
                            <option value="pending">pending</option>
                            <option value="delivered">delivered</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary btn-sm w-100" onclick="loadQueue(1)">Filter</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Unit</th>
                                <th>Msg Type</th>
                                <th>Task ID</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody id="queueBody">
                            <tr><td colspan="8" class="text-center text-muted">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="pageInfo">-</span>
                    <div>
                        <button class="btn btn-outline-light btn-sm me-2" id="prevBtn" onclick="changePage(-1)">Previous</button>
                        <button class="btn btn-outline-light btn-sm" id="nextBtn" onclick="changePage(1)">Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        let m_page = 1;
        const m_limit = 50;

        // Andruav message type names (from src/messageHandlers.js)
        const MSG_TYPES = {
            9001: 'LoadTasks',
            9002: 'SaveTasks',
            9003: 'DeleteTasks',
            9004: 'DisableTasks',
            9009: 'UnitOnline',
            9010: 'LoadMission',
            9011: 'SaveMission',
            9012: 'DeleteMission'
        };

        function fmtTime(epoch) {
            if (!epoch) return '-';
            return new Date(epoch * 1000).toISOString().replace('T', ' ').substring(0, 19) + ' UTC';
        }

        function statusBadge(status) {
            return status === 'pending'
                ? '<span class="badge bg-warning text-dark">pending</span>'
                : '<span class="badge bg-success">delivered</span>';
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function loadUnitFilter() {
            try {
                const res = await fetch('/admin/api/units/list');
                const data = await res.json();
                if (data.error) return;
                const sel = document.getElementById('filterUnit');
                data.unitIds.forEach(id => {
                    const opt = document.createElement('option');
                    opt.value = id; opt.textContent = id;
                    sel.appendChild(opt);
                });
            } catch (e) { console.error(e); }
        }

        async function loadQueue(page) {
            if (page) m_page = page;
            const unit = document.getElementById('filterUnit').value;
            const status = document.getElementById('filterStatus').value;
            const params = new URLSearchParams({ page: m_page, limit: m_limit });
            if (unit) params.set('unitId', unit);
            if (status) params.set('status', status);

            try {
                const res = await fetch('/admin/api/queue?' + params.toString());
                const data = await res.json();
                if (data.error) { alert(data.errorMessage); return; }

                const body = document.getElementById('queueBody');
                if (!data.rows || data.rows.length === 0) {
                    body.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No queued messages</td></tr>';
                } else {
                    body.innerHTML = data.rows.map((q, i) => `
                        <tr>
                            <td>${escapeHtml(q.id)}</td>
                            <td class="small">${escapeHtml(q.unit_id)}</td>
                            <td class="small">${escapeHtml(q.message_type)} <span class="text-muted">(${escapeHtml(MSG_TYPES[q.message_type] || 'unknown')})</span></td>
                            <td class="small">${escapeHtml(q.task_id || '-')}</td>
                            <td>${escapeHtml(q.priority ?? 0)}</td>
                            <td>${statusBadge(q.status)}</td>
                            <td class="small">${escapeHtml(fmtTime(q.created_at))}</td>
                            <td><button class="btn btn-outline-light btn-sm" onclick="toggleData(${i})">show</button></td>
                        </tr>
                        <tr id="dataRow${i}" style="display:none;">
                            <td colspan="8"><pre class="json-pre">${escapeHtml(JSON.stringify(q.message_data, null, 2))}</pre></td>
                        </tr>
                    `).join('');
                }

                const totalPages = data.totalPages || 1;
                document.getElementById('pageInfo').textContent =
                    `Page ${data.page} of ${totalPages} — ${data.total} total`;
                document.getElementById('prevBtn').disabled = data.page <= 1;
                document.getElementById('nextBtn').disabled = data.page >= totalPages;
            } catch (e) {
                console.error('Error loading queue:', e);
            }
        }

        function toggleData(i) {
            const row = document.getElementById('dataRow' + i);
            if (!row) return;
            const isHidden = row.style.display === 'none';
            row.style.display = isHidden ? '' : 'none';
            const btn = document.querySelector('button[onclick="toggleData(' + i + ')"]');
            if (btn) btn.textContent = isHidden ? 'hide' : 'show';
        }

        function changePage(delta) { loadQueue(m_page + delta); }
        loadUnitFilter().then(() => loadQueue(1));
    </script>
</body>
</html>
