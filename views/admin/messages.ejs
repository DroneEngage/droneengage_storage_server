<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/public/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #212529; color: #f8f9fa; }
        .navbar-custom { background: #343a40; }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link { color: #f8f9fa !important; }
        .card { background: #2c3034; border: 1px solid #495057; }
        .card-header { background: #2c3034; border-bottom: 1px solid #495057; color: #f8f9fa; }
        .card-title { color: #e9ecef; }
        .text-muted { color: #adb5bd !important; }
        .btn-primary { background: #0d6efd; border: none; }
        .btn-primary:hover { background: #0b5ed7; }
        .btn-outline-light { border-color: #f8f9fa; color: #f8f9fa; }
        .btn-outline-light:hover { background: #f8f9fa; color: #212529; }
        .table { color: #f8f9fa; border-color: #495057; }
        .table > :not(caption) > * > * {
            background-color: transparent; color: #f8f9fa; border-color: #495057;
        }
        .table-light { background: #2c3034; color: #f8f9fa; }
        .form-control, .form-select {
            background: #2c3034; border: 1px solid #495057; color: #f8f9fa;
        }
        .form-control:focus, .form-select:focus {
            background: #2c3034; border-color: #86b7fe; color: #f8f9fa;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .badge-load    { background: #0d6efd; }
        .badge-save    { background: #198754; }
        .badge-delete  { background: #dc3545; }
        .badge-disable { background: #6c757d; }
    </style>
</head>
<body>
    <%- include('../common/navbar', { activePage: 'messages', navbarFixed: false, dashboardGuid: dashboardGuid, adminUsername: adminUsername }) %>

    <div class="container-fluid mt-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Access Log (Messages)</h5>
                <button class="btn btn-primary btn-sm" onclick="loadMessages()">Refresh</button>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Audit trail of every load/save/delete/disable operation performed by the storage server.</p>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Action</label>
                        <select class="form-select form-select-sm" id="filterAction">
                            <option value="">All</option>
                            <option value="load">load</option>
                            <option value="save">save</option>
                            <option value="delete">delete</option>
                            <option value="disable">disable</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Unit ID</label>
                        <input type="text" class="form-control form-control-sm" id="filterUnit" placeholder="exact unit id">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary btn-sm w-100" onclick="loadMessages(1)">Filter</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Unit ID</th>
                                <th>Action</th>
                                <th>Resource</th>
                                <th>Resource ID</th>
                                <th>Comm Server</th>
                            </tr>
                        </thead>
                        <tbody id="messagesBody">
                            <tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="pageInfo">-</span>
                    <div>
                        <button class="btn btn-outline-light btn-sm me-2" id="prevBtn" onclick="changePage(-1)">Previous</button>
                        <button class="btn btn-outline-light btn-sm" id="nextBtn" onclick="changePage(1)">Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        let m_page = 1;
        const m_limit = 50;

        function actionBadge(action) {
            const cls = { load: 'badge-load', save: 'badge-save', delete: 'badge-delete', disable: 'badge-disable' }[action] || 'bg-secondary';
            return `<span class="badge ${cls}">${action}</span>`;
        }

        function fmtTime(epoch) {
            if (!epoch) return '-';
            const d = new Date(epoch * 1000);
            return d.toISOString().replace('T', ' ').substring(0, 19) + ' UTC';
        }

        async function loadMessages(page) {
            if (page) m_page = page;
            const action = document.getElementById('filterAction').value;
            const unit = document.getElementById('filterUnit').value.trim();
            const params = new URLSearchParams({ page: m_page, limit: m_limit });
            if (action) params.set('action', action);
            if (unit) params.set('unitId', unit);

            try {
                const res = await fetch('/admin/api/messages?' + params.toString());
                const data = await res.json();
                if (data.error) { alert(data.errorMessage); return; }

                const body = document.getElementById('messagesBody');
                if (!data.rows || data.rows.length === 0) {
                    body.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No messages found</td></tr>';
                } else {
                    body.innerHTML = data.rows.map(r => `
                        <tr>
                            <td class="small">${fmtTime(r.created_at)}</td>
                            <td class="small">${r.unit_id || '-'}</td>
                            <td>${actionBadge(r.action)}</td>
                            <td class="small">${r.resource_type || '-'}</td>
                            <td class="small">${r.resource_id || '-'}</td>
                            <td class="small">${r.comm_server_id || '-'}</td>
                        </tr>
                    `).join('');
                }

                const totalPages = data.totalPages || 1;
                document.getElementById('pageInfo').textContent =
                    `Page ${data.page} of ${totalPages} — ${data.total} total`;
                document.getElementById('prevBtn').disabled = data.page <= 1;
                document.getElementById('nextBtn').disabled = data.page >= totalPages;
            } catch (e) {
                console.error('Error loading messages:', e);
            }
        }

        function changePage(delta) {
            loadMessages(m_page + delta);
        }

        loadMessages(1);
    </script>
</body>
</html>
