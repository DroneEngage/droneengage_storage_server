<%
// Common admin navbar partial for the storage server dashboard.
//
// Expects these locals (passed from the parent view or route):
//   activePage    — string: 'dashboard' | 'messages' | 'units' | 'tasks' | 'missions' | 'queue'
//   navbarFixed   — boolean: true adds Bootstrap 'fixed-top'
//   dashboardGuid — string|null: GUID prefix for admin URLs
//   adminUsername — string|null: logged-in admin username

const guidPrefix = dashboardGuid ? '/' + dashboardGuid : '';

const brandMap = {
    'dashboard': { text: 'Storage Dashboard', link: '/dashboard' },
    'messages':  { text: 'Access Log',        link: '/messages'  },
    'units':     { text: 'Units',             link: '/units'     },
    'tasks':     { text: 'Tasks',             link: '/tasks'     },
    'missions':  { text: 'Missions',          link: '/missions'  },
    'queue':     { text: 'Offline Queue',     link: '/queue'     }
};
const brand = brandMap[activePage] || brandMap['dashboard'];
const navClass = navbarFixed
    ? 'navbar navbar-expand-lg navbar-custom fixed-top'
    : 'navbar navbar-expand-lg navbar-custom';
%>
<nav class="<%= navClass %>">
    <div class="container-fluid">
        <a class="navbar-brand" href="/admin<%= guidPrefix %><%= brand.link %>"><%= brand.text %></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link<%= activePage === 'dashboard' ? ' active' : '' %>" href="/admin<%= guidPrefix %>/dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link<%= activePage === 'messages' ? ' active' : '' %>" href="/admin<%= guidPrefix %>/messages">Messages</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link<%= activePage === 'units' ? ' active' : '' %>" href="/admin<%= guidPrefix %>/units">Units</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link<%= activePage === 'tasks' ? ' active' : '' %>" href="/admin<%= guidPrefix %>/tasks">Tasks</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link<%= activePage === 'missions' ? ' active' : '' %>" href="/admin<%= guidPrefix %>/missions">Missions</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link<%= activePage === 'queue' ? ' active' : '' %>" href="/admin<%= guidPrefix %>/queue">Queue</a>
                </li>
            </ul>
            <% if (adminUsername) { %>
            <span class="navbar-text me-3 text-white">Welcome, <%= adminUsername %></span>
            <form method="POST" action="/admin/logout" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
            </form>
            <% } %>
        </div>
    </div>
</nav>

<% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
<script>
    // Expose CSRF token to client-side JS and auto-inject it into all
    // state-changing fetch() calls via the X-CSRF-Token header.
    window.CSRF_TOKEN = <%- JSON.stringify(csrfToken) %>;
    (function() {
        const originalFetch = window.fetch;
        window.fetch = function(input, init) {
            init = init || {};
            const method = (init.method || 'GET').toUpperCase();
            if (['POST', 'PUT', 'DELETE', 'PATCH'].includes(method) && window.CSRF_TOKEN) {
                init.headers = init.headers || {};
                if (init.headers instanceof Headers) {
                    if (!init.headers.has('X-CSRF-Token')) {
                        init.headers.set('X-CSRF-Token', window.CSRF_TOKEN);
                    }
                } else {
                    if (!init.headers['X-CSRF-Token']) {
                        init.headers['X-CSRF-Token'] = window.CSRF_TOKEN;
                    }
                }
            }
            return originalFetch(input, init);
        };
    })();
</script>
<% } %>
